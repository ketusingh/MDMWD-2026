<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Professional Resume</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Calibri, Arial, sans-serif;
}

body{
    background:#e5e5e5;
    padding:30px;
}

.resume{
    width:850px;
    margin:auto;
    background:#fff;
    display:grid;
    grid-template-columns:260px 1fr;
    border-radius:12px;
    overflow:hidden;
    box-shadow:0 8px 20px rgba(0,0,0,0.2);
}

.sidebar{
    background:#1b3a57;
    color:white;
    padding:30px 20px;
}

.photo{
    width:140px;
    height:140px;
    border-radius:50%;
    border:4px solid white;
    margin:0 auto 20px;
    background:#ffffff;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:14px;
    color:#1b3a57;
}

.sidebar h3{
    margin:20px 0 10px;
    border-bottom:2px solid white;
    padding-bottom:5px;
}

.sidebar p,
.sidebar li{
    font-size:15px;
    line-height:1.8;
}

.sidebar ul{
    margin-left:18px;
}

.main{
    padding:35px;
}

.main h1{
    color:#1b3a57;
    font-size:36px;
}

.main h4{
    color:#666;
    margin-bottom:25px;
}

.section{
    margin-bottom:25px;
}

.section h2{
    color:#1b3a57;
    margin-bottom:10px;
    border-left:5px solid #1b3a57;
    padding-left:10px;
}

.section p,
.section li{
    color:#444;
    line-height:1.8;
    font-size:15px;
}

.section ul{
    margin-left:20px;
}
</style>

</head>
<body>

<div class="resume">

    <div class="sidebar">

        <div class="photo">PHOTO</div>

        <h3>Contact</h3>
        <p>📞 +91 9876543210</p>
        <p>📧 yourname@email.com</p>
        <p>📍 Your City, India</p>

        <h3>Skills</h3>
        <ul>
            <li>HTML5</li>
            <li>CSS3</li>
            <li>Java</li>
            <li>C Programming</li>
            <li>MS Office</li>
        </ul>

        <h3>Languages</h3>
        <ul>
            <li>English</li>
            <li>Hindi</li>
        </ul>

    </div>

    <div class="main">

        <h1>Your Name</h1>
        <h4>Computer Science Student</h4>

        <div class="section">
            <h2>Career Objective</h2>
            <p>
                Seeking an opportunity to apply my technical knowledge,
                improve my skills, and contribute effectively to the growth
                of the organization.
            </p>
        </div>

        <div class="section">
            <h2>Education</h2>
            <ul>
                <li><b>B.Tech in Computer Science</b> – XYZ College (2023–2027)</li>
                <li><b>Higher Secondary (12th)</b> – ABC School</li>
                <li><b>Secondary (10th)</b> – ABC School</li>
            </ul>
        </div>

        <div class="section">
            <h2>Projects</h2>
            <ul>
                <li>Personal Portfolio Website</li>
                <li>Student Registration Form</li>
                <li>Resume Design Using HTML & CSS</li>
            </ul>
        </div>

        <div class="section">
            <h2>Certifications</h2>
            <ul>
                <li>HTML & CSS Basics</li>
                <li>Java Programming</li>
            </ul>
        </div>

        <div class="section">
            <h2>Hobbies</h2>
            <p>Reading • Coding • Cricket • Music</p>
        </div>

    </div>

</div>

</body>
</html>
