<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>College Tech Fest Invitation</title>

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-blue-100">

    <!-- Main Container -->
    <div class="max-w-4xl mx-auto my-10 bg-white rounded-xl shadow-xl border-4 border-blue-600">

        <!-- Header -->
        <div class="bg-blue-600 text-white text-center py-6 rounded-t-lg">
            <h1 class="text-5xl font-bold">TECH FEST 2026</h1>
            <p class="text-xl mt-2">Annual Technical Festival</p>
        </div>

        <!-- Content -->
        <div class="p-8">

            <h2 class="text-3xl font-bold text-center text-blue-700 mb-4">
                🎉 Invitation
            </h2>

            <p class="text-lg text-gray-700 text-center leading-8">
                The Department of Computer Science & Engineering warmly invites
                all students and faculty members to participate in the Annual
                Technical Festival. Join us for exciting coding competitions,
                robotics, technical quizzes, project exhibitions, workshops,
                and many more fun-filled activities.
            </p>

            <!-- Event Details -->
            <div class="mt-8 bg-gray-100 p-6 rounded-lg border border-gray-300">

                <h3 class="text-2xl font-bold text-blue-700 mb-4">
                    Event Details
                </h3>

                <p class="mb-2"><strong>📅 Date:</strong> 20 September 2026</p>
                <p class="mb-2"><strong>⏰ Time:</strong> 9:00 AM Onwards</p>
                <p><strong>📍 Venue:</strong> College Auditorium</p>

            </div>

            <!-- Registration Form -->
            <div class="mt-10 bg-blue-50 p-6 rounded-lg border border-blue-300">

                <h3 class="text-2xl font-bold text-center text-blue-700 mb-6">
                    Register for Tech Fest
                </h3>

                <form>

                    <!-- Name -->
                    <div class="mb-4">
                        <label class="block font-semibold mb-2">
                            Full Name
                        </label>

                        <input
                            type="text"
                            placeholder="Enter your full name"
                            class="w-full border border-gray-300 rounded-lg p-3 focus:outline-none focus:ring-2 focus:ring-blue-500"
                            required>
                    </div>

                    <!-- Email -->
                    <div class="mb-4">
                        <label class="block font-semibold mb-2">
                            Email ID
                        </label>

                        <input
                            type="email"
                            placeholder="Enter your email address"
                            class="w-full border border-gray-300 rounded-lg p-3 focus:outline-none focus:ring-2 focus:ring-blue-500"
                            required>
                    </div>

                    <!-- Mobile -->
                    <div class="mb-4">
                        <label class="block font-semibold mb-2">
                            Mobile Number
                        </label>

                        <input
                            type="tel"
                            placeholder="Enter your mobile number"
                            class="w-full border border-gray-300 rounded-lg p-3 focus:outline-none focus:ring-2 focus:ring-blue-500"
                            required>
                    </div>

                    <!-- Department -->
                    <div class="mb-6">
                        <label class="block font-semibold mb-2">
                            Department
                        </label>

                        <select
                            class="w-full border border-gray-300 rounded-lg p-3 focus:outline-none focus:ring-2 focus:ring-blue-500">
                            <option>Select Department</option>
                            <option>Computer Science</option>
                            <option>Information Technology</option>
                            <option>Electronics</option>
                            <option>Mechanical</option>
                            <option>Civil</option>
                        </select>
                    </div>

                    <!-- Buttons -->
                    <div class="text-center">

                        <button
                            type="submit"
                            class="bg-blue-600 text-white px-8 py-3 rounded-lg hover:bg-blue-700 font-semibold">
                            Register Now
                        </button>

                        <button
                            type="reset"
                            class="bg-gray-600 text-white px-8 py-3 rounded-lg hover:bg-gray-700 ml-4 font-semibold">
                            Reset
                        </button>

                    </div>

                </form>

            </div>

        </div>

        <!-- Footer -->
        <div class="bg-blue-600 text-white text-center py-5 rounded-b-lg">

            <h3 class="text-xl font-bold">
                Department of Computer Science & Engineering
            </h3>

            <p class="mt-2">
                We look forward to your participation!
            </p>

        </div>

    </div>

</body>
</html>
